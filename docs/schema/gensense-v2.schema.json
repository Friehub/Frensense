{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenSense Rule Definition Schema (v0.2.2)",
  "description": "Legacy schema for v0.2.2 diagnostic rules. Does not support auto-remediation or CSA project rules.",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file_rule"
      }
    }
  },
  "definitions": {
    "severity": {
      "type": "string",
      "enum": ["Critical", "Warning", "Info"]
    },
    "file_rule": {
      "type": "object",
      "required": ["id", "name", "severity", "category", "observation", "impact", "improvement", "target_ext", "on_node"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$",
          "description": "Unique identifier in SCREAMING_SNAKE_CASE."
        },
        "name": {
          "type": "string",
          "description": "Human-readable name of the rule."
        },
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "category": {
          "type": "string",
          "description": "Logical grouping (Security, Performance, etc.)."
        },
        "observation": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "improvement": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target_ext": {
          "type": "string",
          "description": "File extensions (e.g., 'ts', 'rs')."
        },
        "on_node": {
          "type": "string",
          "description": "Tree-sitter node type."
        },
        "if_matches": {
          "type": "string"
        },
        "must_not_contain": {
          "type": "string"
        },
        "must_contain": {
          "type": "string"
        },
        "max_lines": {
          "type": "integer"
        },
        "max_depth": {
          "type": "integer"
        },
        "source_pattern": {
          "type": "string",
          "description": "Taint analysis source regex."
        },
        "sink_pattern": {
          "type": "string",
          "description": "Taint analysis sink regex."
        }
      }
    }
  }
}
