#!/bin/bash
# GenSense Pre-Commit Hook
# Standardizes integrity checks before local commits.

set -e

echo "[GENSENSE] Starting pre-commit checks..."

# 1. Format Check
echo "[FMT] Checking formatting..."
cargo fmt --all -- --check

# 2. Clippy Lints
echo "[CHECK] Running semantic lints..."
cargo clippy --all-targets --all-features -- -W clippy::pedantic -D warnings

# 3. Quick Tests
echo "[TEST] Running unit tests..."
cargo test --lib --bins

echo "[SUCCESS] All checks passed. Proceeding with commit."
exit 0
