{
  "name": "@friehub/gensense",
  "version": "0.2.2",
  "description": "GenSense: Semantic Diagnostic Engine",
  "main": "gensense.js",
  "types": "gensense.d.ts",
  "bin": {
    "gensense": "bin/gensense.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Friehub/gensense"
  },
  "files": [
    "bin",
    "dist",
    "gensense.js",
    "gensense.d.ts",
    "index.js",
    "rules"
  ],
  "napi": {
    "name": "gensense",
    "package": {
      "name": "@friehub/gensense"
    }
  },
  "scripts": {
    "build": "napi build --release --features node,rust,typescript",
    "build:debug": "napi build --features node,rust,typescript",
    "test": "node tests/node/integration.test.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "postinstall": "chmod +x bin/gensense.js dist/gensense dist/binaries/gensense-* 2>/dev/null || true"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.12.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.34"
  }
}
