{
  "name": "@friehub/gensense",
  "version": "0.4.0",
  "description": "GenSense: Semantic Diagnostic Engine",
  "main": "gensense.js",
  "types": "gensense.d.ts",
  "bin": {
    "gensense": "bin/gensense.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Friehub/gensense.git"
  },
  "files": [
    "bin",
    "dist",
    "gensense.js",
    "gensense.d.ts",
    "rules",
    "README.md",
    "CHANGELOG.md",
    "gensense.linux-x64-gnu.node",
    "gensense.darwin-x64.node",
    "gensense.darwin-arm64.node",
    "gensense.win32-x64-msvc.node"
  ],
  "napi": {
    "name": "gensense",
    "package": {
      "name": "@friehub/gensense"
    }
  },
  "scripts": {
    "build": "napi build --release --cargo-cwd gensense-node --dts gensense.d.ts",
    "build:debug": "napi build --cargo-cwd gensense-node --dts gensense.d.ts",
    "test": "node tests/node/integration.test.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "postinstall": "chmod +x bin/gensense.js dist/gensense dist/binaries/gensense-* 2>/dev/null || true"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.12.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.34"
  }
}
