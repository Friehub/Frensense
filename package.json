{
  "name": "@friehub/gensense",
  "version": "0.1.0",
  "description": "GenSense: Semantic Diagnostic Engine",
  "main": "gensense.js",
  "types": "gensense.d.ts",
  "bin": {
    "gensense": "bin/gensense.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "napi": {
    "name": "gensense",
    "package": {
      "name": "@friehub/gensense"
    }
  },
  "scripts": {
    "build": "napi build --release --features node,rust,typescript",
    "build:debug": "napi build --features node",
    "test": "node tests/node/integration.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.12.0"
  }
}
