{
  "name": "gensense-vscode",
  "displayName": "GenSense",
  "description": "Semantic security diagnostics for Rust, TypeScript and Solidity powered by the GenSense v0.3.0 engine.",
  "version": "0.3.0",
  "publisher": "friehub",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:solidity"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gensense.runScan",
        "title": "GenSense: Run Scan on Workspace"
      },
      {
        "command": "gensense.clearDiagnostics",
        "title": "GenSense: Clear Diagnostics"
      }
    ],
    "configuration": {
      "title": "GenSense",
      "properties": {
        "gensense.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the gensense binary. Leave empty to auto-detect from PATH or workspace."
        },
        "gensense.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run GenSense diagnostics on file save."
        },
        "gensense.minSeverity": {
          "type": "string",
          "enum": [
            "Critical",
            "Warning",
            "Info"
          ],
          "default": "Warning",
          "description": "Minimum severity level to surface as diagnostics."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.9.3"
  }
}
